# Local stdio / npm run auth
GOOGLE_OAUTH_CLIENT_PATH=/Users/YOU/.config/google-workspace-mcp/client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=/Users/YOU/.config/google-workspace-mcp/token.json

# Shared secret for remote MCP HTTP (required on Vercel)
MCP_AUTH_TOKEN=generate-a-long-random-string
REQUIRE_MCP_AUTH=true

# Hosted (Vercel) — Path A: paste JSON secrets (never commit real values)
# GOOGLE_OAUTH_CLIENT_JSON={"installed":{"client_id":"...","client_secret":"...",...}}
# GOOGLE_OAUTH_TOKEN_JSON={"access_token":"...","refresh_token":"...",...}
# Or instead of CLIENT_JSON:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
