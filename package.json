{
  "name": "google-workspace-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for sending Gmail and appending to Google Docs from Cursor",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-workspace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "tsx src/http/local-server.ts",
    "auth": "tsx src/auth/authorize.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "gmail",
    "google-docs",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "googleapis": "^161.0.0",
    "open": "^10.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
